# NumidAI configuration (copy to .env — never commit .env)
# All data (project submissions + admin login) is MongoDB-backed via
# api/projects/*, api/login.js, api/me.js -- no Supabase.
# Also set these in the Vercel project's Environment Variables (dashboard or
# `vercel env add`) for production/preview -- .env is local-only, gitignored.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=generate-a-long-random-string-do-not-reuse-the-example
